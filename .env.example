# ==== Postgres ====
DB_USER=app
DB_PASSWORD=app_dev
DB_NAME=appdb

# ==== Backend ====
SERVER_PORT=8080
# JDBC URL. In docker-compose the host is overridden to `postgres`.
DATABASE_URL=jdbc:postgresql://localhost:5432/appdb
# Allowed CORS origin (the frontend dev server).
FRONTEND_URL=http://localhost:5173

# ==== LLM proxy contract (backend -> LiteLLM) ====
# In docker-compose LLM_API_BASE is overridden to http://litellm:4000
LLM_API_BASE=http://localhost:4000
LLM_API_KEY=sk-anything
# Must match a `model_name` in litellm/litellm_config.yaml.
# Options: hai-gpt-4.1-mini | hai-gpt-5-mini | ollama-qwen3 | gpt-4o-mini
LLM_MODEL=hai-gpt-4.1-mini

# ==== Upstream backends (read by LiteLLM only) ====
# SAP Hai proxy (OpenAI-compatible under /openai/v1). From inside the litellm
# container the host is reached via host.docker.internal.
HAI_API_BASE=http://host.docker.internal:6655/openai/v1
HAI_API_KEY=your-hai-proxy-key
# Local Ollama
OLLAMA_API_BASE=http://host.docker.internal:11434
# Direct OpenAI (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ==== Observability (backend -> Grafana LGTM via OTLP) ====
# service.name shown in Grafana.
APP_NAME=pace-pilot
# In docker-compose these point at http://lgtm:4318. Defaults below target a
# local collector for bare `./gradlew bootRun`.
OTEL_METRICS_URL=http://localhost:4318/v1/metrics
OTEL_TRACES_URL=http://localhost:4318/v1/traces
OTEL_LOGS_URL=http://localhost:4318/v1/logs
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ==== Frontend ====
# Absolute API base for the browser client. Leave unset to use the relative
# `/api` path (works behind the Vite dev proxy and nginx in prod).
# VITE_API_URL=http://localhost:8080
